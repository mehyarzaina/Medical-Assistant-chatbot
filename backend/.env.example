# Copy this file to .env and fill in your own values.

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGO_DB_NAME=altibbi_dr

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379/0

# Groq LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Zilliz Cloud (vector search)
ZILLIZ_URI=
ZILLIZ_TOKEN=
DR_COLLECTION_NAME=altibbi_doctors
ARTICLES_COLLECTION_NAME=altibbi_articles

# Embedding service
EMBEDDING_URL=
EMBEDDING_API_KEY=

# Gmail SMTP (use a Google App Password, not your account password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
FRONTEND_BASE_URL=http://localhost:5173

# Google Calendar
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary

# Slot length in minutes
APPOINTMENT_DURATION_MINUTES=30

# Password for the /admin pages
ADMIN_PASSWORD=
